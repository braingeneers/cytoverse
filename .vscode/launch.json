{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "scimilarity export model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/scimilarity_export_model.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/data/scimilarity/model_v1.1",
        "${workspaceFolder}/web/public/models/scimilarity/embedding"
      ]
    },
    {
      "name": "scimilarity export embeddings",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/scimilarity_export_embeddings.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/data/scimilarity/model_v1.1/cellsearch",
        "${workspaceFolder}/data/scimilarity",
        "--labels",
        "prediction",
        "--labels",
        "tissue",
        "--validate",
        "--stratify",
        "--num-embeddings",
        "1000"
      ]
    },
    {
      "name": "umap train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/umap.py",
      "console": "integratedTerminal",
      "args": [
        "train",
        "${workspaceFolder}/data/scimilarity/embeddings.npy",
        "${workspaceFolder}/web/public/models/scimilarity/",
        "--num-embeddings",
        "100000"
      ]
    },
    {
      "name": "umap map",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/umap.py",
      "console": "integratedTerminal",
      "args": [
        "map",
        "${workspaceFolder}/web/public/models/scimilarity/umap.onnx",
        "${workspaceFolder}/data/scimilarity/embeddings.npy",
        "${workspaceFolder}/data/scimilarity/",
        "--export-png",
        "--num-embeddings",
        "1000"
      ]
    },
    {
      "name": "umap export",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/umap.py",
      "console": "integratedTerminal",
      "args": [
        "export",
        "${workspaceFolder}/data/scimilarity/",
        "${workspaceFolder}/web/public/models/scimilarity/"
      ]
    },
    {
      "name": "pq train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/ivfpq_train.py",
      "console": "integratedTerminal",
      "args": [
        "train-pq",
        "${workspaceFolder}/data/scimilarity/embeddings.npy",
        "${workspaceFolder}/web/public/models/scimilarity/pq",
        "--m",
        "16",
        "--k",
        "256",
        "--max-vectors",
        "1000",
        "--n-iterations",
        "30"
      ]
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Playwright Chrome",
      "port": 9222,
      "url": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}/web",
      "timeout": 30000
    }
  ]
}
