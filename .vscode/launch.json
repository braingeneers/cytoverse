{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "tune brain",
      "type": "debugpy",
      "justMyCode": false,
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/tune.py",
      "console": "integratedTerminal",
      "args": ["${workspaceFolder}/../sims-web/data/allen-celltypes+human-cortex+m1.h5ad"]
    },
    {
      "name": "ingest h5ad as reference",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/ingest_h5ad_as_reference.py",
      "console": "integratedTerminal",
      "args": [
        "data/integrated_data_10k.h5ad",
        "${workspaceFolder}/data/scimilarity/model_v1.1",
        "data/brain",
        "--labels",
        "CellType",
        "--labels",
        "tissue_type",
        "--max-cells",
        "10"
      ]
    },
    {
      "name": "scimilarity export model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/scimilarity_export_model.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/data/scimilarity/model_v1.1",
        "${workspaceFolder}/web/public/models/scimilarity/embedding"
      ]
    },
    {
      "name": "scimilarity export embeddings",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/scimilarity_export_embeddings.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/data/scimilarity/model_v1.1/cellsearch",
        "${workspaceFolder}/data/scimilarity",
        "--labels",
        "prediction",
        "--labels",
        "tissue",
        "--labels",
        "author_label",
        "--labels",
        "study",
        "--validate"
      ]
    },
    {
      "name": "umap train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/pumap_train.py",
      "console": "integratedTerminal",
      "args": [
        "train",
        "${workspaceFolder}/data/scimilarity/vectors.npy",
        "${workspaceFolder}/data/scimilarity/labels.parquet",
        "${workspaceFolder}/web/public/models/scimilarity/pumap",
        "--num-vectors",
        "10000"
      ]
    },
    {
      "name": "umap map",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/pumap_train.py",
      "console": "integratedTerminal",
      "args": [
        "map",
        "${workspaceFolder}/web/public/models/scimilarity/pumap/model.onnx",
        "${workspaceFolder}/data/scimilarity/vectors.npy",
        "${workspaceFolder}/data/scimilarity/",
        "--num-vectors",
        "10000",
        "--export-png"
      ]
    },
    {
      "name": "umap export",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/pumap_train.py",
      "console": "integratedTerminal",
      "args": [
        "export",
        "${workspaceFolder}/data/scimilarity/",
        "${workspaceFolder}/web/public/models/scimilarity/pumap"
      ]
    },
    {
      "name": "pq train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/ivfpq_train.py",
      "console": "integratedTerminal",
      "args": [
        "pq-train",
        "${workspaceFolder}/data/scimilarity/vectors.npy",
        "${workspaceFolder}/web/public/models/scimilarity/pq",
        "--m",
        "16",
        "--k",
        "256",
        "--max-vectors",
        "100000",
        "--n-iterations",
        "30"
      ]
    },
    {
      "name": "ivf train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/ivfpq_train.py",
      "console": "integratedTerminal",
      "args": [
        "ivf-train",
        "${workspaceFolder}/data/scimilarity/vectors.npy",
        "${workspaceFolder}/web/public/models/scimilarity/ivf",
        "--n-partitions",
        "64",
        "--max-vectors",
        "100000",
        "--n-iterations",
        "30"
      ]
    },
    {
      "name": "ivfpq export",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/ivfpq_train.py",
      "console": "integratedTerminal",
      "args": [
        "ivfpq-export",
        "${workspaceFolder}/web/public/models/scimilarity",
        "${workspaceFolder}/data/scimilarity/vectors.npy",
        "--max-vectors",
        "250000"
      ]
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Playwright Chrome",
      "port": 9222,
      "url": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}/web",
      "timeout": 30000
    }
  ]
}
