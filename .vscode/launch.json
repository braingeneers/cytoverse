{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "export scimilarity model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/scimilarity_export_model.py",
      "console": "integratedTerminal",
      "args": [
        "data/models/scimilarity/model_v1.1",
        "${workspaceFolder}/public/models/dev/embedding"
      ]
    },
    {
      "name": "export scimilarity embedding",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/scimilarity_to_embeddings.py",
      "console": "integratedTerminal",
      "args": [
        "data/models/scimilarity/model_v1.1/cellsearch",
        "data/references/dev",
        "--labels",
        "prediction",
        "--labels",
        "tissue",
        "--labels",
        "author_label",
        "--labels",
        "study",
        "--num-embeddings",
        "100_000",
        "--validate"
      ]
    },
    {
      "name": "ivfpq train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/ivfpq_train.py",
      "console": "integratedTerminal",
      "args": [
        "train",
        "${workspaceFolder}/data/references/scimilarity/embeddings.npy",
        "${workspaceFolder}/public/models/dev/ivfpq",
        "--max-vectors",
        "100_000",
        "--max-vectors-for-training",
        "10_000",
        "--pq-m",
        "32",
        "--pq-k",
        "256",
        "--sample-training-vectors",
        "--test"
      ]
    },
    {
      "name": "export h5ad embeddings",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/h5ad_to_embeddings.py",
      "console": "integratedTerminal",
      "args": [
        "~/data/h5ad/allen-celltypes+human-cortex+various-cortical-areas.h5ad",
        "data/scimilarity/model_v1.1",
        "data/allen",
        "--labels",
        "CellType",
        "--labels",
        "cortical_layer_label"
      ]
    },
    {
      "name": "pumap train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/pumap_train.py",
      "console": "integratedTerminal",
      "args": [
        "train",
        "${workspaceFolder}/data/references/scimilarity/embeddings.npy",
        "${workspaceFolder}/data/references/scimilarity/labels.parquet",
        "${workspaceFolder}/public/models/dev/pumap",
        "--num-vectors",
        "10_000"
      ]
    },
    {
      "name": "pumap map",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/pumap_train.py",
      "console": "integratedTerminal",
      "args": [
        "map",
        "${workspaceFolder}/public/models/dev/pumap/model.onnx",
        "${workspaceFolder}/data/references/scimilarity/embeddings.npy",
        "${workspaceFolder}/data/references/dev",
        "--num-vectors",
        "10_000",
        "--export-png"
      ]
    },
    {
      "name": "pumap export",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/pumap_train.py",
      "console": "integratedTerminal",
      "args": [
        "export",
        "${workspaceFolder}/data/references/dev/",
        "${workspaceFolder}/public/models/dev/pumap"
      ]
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest Tests",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "${relativeFile}"
      ],
      "smartStep": true,
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Playwright Chrome",
      "port": 9222,
      "url": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}",
      "timeout": 30000,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/ivfpq/typescript/dist/**/*.js"
      ],
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${workspaceFolder}/src/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "webpack:///src/*": "${workspaceFolder}/src/*",
        "./src/*": "${workspaceFolder}/ivfpq/typescript/src/*",
        "../src/*": "${workspaceFolder}/src/*",
        "../../src/*": "${workspaceFolder}/src/*"
      }
    }
  ]
}
