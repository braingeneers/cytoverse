{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "scimilarity export model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/scimilarity_export_model.py",
      "console": "integratedTerminal",
      "args": [
        "data/scimilarity/model_v1.1",
        "${workspaceFolder}/public/models/scimilarity/embedding"
      ]
    },
    {
      "name": "export scimilarity embedding",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/scimilarity_to_embeddings.py",
      "console": "integratedTerminal",
      "args": [
        "data/scimilarity/model_v1.1/cellsearch",
        "data/scimilarity",
        "--labels",
        "prediction",
        "--labels",
        "tissue",
        "--labels",
        "author_label",
        "--labels",
        "study",
        "--num-embeddings",
        "100000",
        "--validate"
      ]
    },
    {
      "name": "export h5ad embeddings",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/h5ad_to_embeddings.py",
      "console": "integratedTerminal",
      "args": [
        "~/data/h5ad/allen-celltypes+human-cortex+various-cortical-areas.h5ad",
        "data/scimilarity/model_v1.1",
        "data/allen",
        "--labels",
        "CellType",
        "--labels",
        "cortical_layer_label"
      ]
    },
    {
      "name": "ivfpq tune",
      "type": "debugpy",
      "justMyCode": false,
      "request": "launch",
      "env": {
        "AWS_PROFILE": "braingeneers"
      },
      "program": "${workspaceFolder}/src/cytoverse/scripts/ivfpq_tune.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/data/references/scimilarity/embeddings.parquet",
        "${workspaceFolder}/data/references/scimilarity/labels.parquet",
        "--num-samples",
        "1",
        "--max-concurrent-trials",
        "1",
        "--debug"
      ]
    },
    {
      "name": "ivfpq train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/ivfpq_train.py",
      "console": "integratedTerminal",
      "args": [
        "train",
        "${workspaceFolder}/data/references/scimilarity/embeddings.npy",
        "${workspaceFolder}/public/models/scimilarity/ivf",
        "--n-partitions",
        "64",
        "--max-vectors",
        "100000",
        "--n-iterations",
        "30"
      ]
    },
    {
      "name": "ivfpq test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/ivfpq_train.py",
      "console": "integratedTerminal",
      "args": [
        "test",
        "${workspaceFolder}/public/models/scimilarity",
        "${workspaceFolder}/data/references/scimilarity/embeddings.npy",
      ]
    },
    {
      "name": "pumap train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/pumap_train.py",
      "console": "integratedTerminal",
      "args": [
        "train",
        "${workspaceFolder}/data/references/scimilarity/embeddings.npy",
        "${workspaceFolder}/data/references/scimilarity/labels.parquet",
        "${workspaceFolder}/public/models/scimilarity/pumap",
        "--num-vectors",
        "10000"
      ]
    },
    {
      "name": "pumap map",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/pumap_train.py",
      "console": "integratedTerminal",
      "args": [
        "map",
        "${workspaceFolder}/public/models/scimilarity/pumap/model.onnx",
        "${workspaceFolder}/data/references/scimilarity/embeddings.npy",
        "${workspaceFolder}/data/references/scimilarity/",
        "--num-vectors",
        "10000",
        "--export-png"
      ]
    },
    {
      "name": "pumap export",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/cytoverse/scripts/pumap_train.py",
      "console": "integratedTerminal",
      "args": [
        "export",
        "${workspaceFolder}/data/scimilarity/",
        "${workspaceFolder}/public/models/scimilarity/pumap"
      ]
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Playwright Chrome",
      "port": 9222,
      "url": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}",
      "timeout": 30000
    }
  ]
}
