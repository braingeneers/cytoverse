{
  "name": "cytoverse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "ivfpq/typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "serve-dist-python": "python3 -m http.server 4173 -d dist/",
    "deploy": "rsync -avh --delete dist/ rcurrie@hgwdev.gi.ucsc.edu:/usr/local/apache/htdocs-cells/cytoverse/",
    "pull-model": "rsync -avh --delete rcurrie@hgwdev.gi.ucsc.edu:~/cytoverse/public/models/scimilarity/ public/models/scimilarity/"
  },
  "dependencies": {
    "@cytoverse/ivfpq": "workspace:*",
    "apache-arrow": "^20.0.0",
    "csv-parse": "^6.1.0",
    "h5wasm": "^0.8.1",
    "idb": "^8.0.3",
    "onnxruntime-web": "^1.22.0",
    "parquet-wasm": "^0.6.1",
    "regl-scatterplot": "^1.14.1",
    "vue": "^3.5.18",
    "vuetify": "^3.7.7",
    "@mdi/font": "^7.4.47"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.53.1",
    "@types/node": "^24.0.3",
    "@vitejs/plugin-vue": "^5.2.2",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@webgpu/types": "^0.1.61",
    "eslint": "^9.25.0",
    "eslint-plugin-vue": "^9.31.0",
    "globals": "^16.0.0",
    "terser": "^5.43.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^3.0.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.1.10"
  }
}
