{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "useDefineForClassFields": true,
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "sourceMap": true,
    "rootDirs": [
      "src",
    ],
    "lib": [
      "ES2021",
      "DOM"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "@webgpu/types"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "benchmark"
  ]
}